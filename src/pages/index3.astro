---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <h1 class="text-2xl">Test Astro et Plot (Observablehq)</h1>

    <select name="species" id="species">
        <option value="">All species</option>
        <option value="Adelie">Adelie</option>
        <option value="Chinstrap">Chinstrap</option>
        <option value="Gentoo">Gentoo</option>
    </select>

    <select name="sex" id="sex">
        <option value="">male and female penguins</option>
        <option value="FEMALE">female penguins</option>
        <option value="MALE">male penguins</option>
    </select>

    <div id="graphique"></div>

    <script>
        import * as Plot from "@observablehq/plot";
        import penguins from "../assets/penguins.json";

        const selectSpecies = document.querySelector(
            "#species",
        ) as HTMLSelectElement;
        const selectSex = document.querySelector("#sex") as HTMLSelectElement;

        function renderPlot() {
            const species = selectSpecies.value;
            const sex = selectSex.value;
            const div = document.querySelector("#graphique") as HTMLDivElement;
            div.innerHTML = "";
            const plot = Plot.plot({
                x: { domain: [30, 60] },
                y: { domain: [12, 22] },
                color: { domain: ["Adelie", "Chinstrap", "Gentoo"] },
                marks: [
                    Plot.dot(penguins, {
                        x: "culmen_length_mm",
                        y: "culmen_depth_mm",
                        stroke: "species",
                        filter: (d) =>
                            (species === "" || d.species === species) &&
                            (sex === "" || d.sex === sex),
                    }),
                ],
            });
            div.append(plot);
        }

        selectSpecies.addEventListener("change", renderPlot);
        selectSex.addEventListener("change", renderPlot);
        renderPlot();
    </script>
</Layout>
