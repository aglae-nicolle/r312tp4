---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";

const especes = ["Adelie", "Chinstrap", "Gentoo"];
---

<Layout>
    <h1 class="text-2xl">Test Astro et Plot (Observablehq)</h1>
    <select name="species" id="species">
        <option value="Adelie">Adelie</option>
        <option value="Chinstrap">Chinstrap</option>
        <option value="Gentoo">Gentoo</option>
    </select>;

    {
        especes.map((espece) => (
            <div data-species={espece} hidden>
                <PlotFigure
                    options={{
                        x: { domain: [30, 60] },
                        y: { domain: [12, 22] },
                        color: { domain: especes },
                        marks: [
                            Plot.dot(
                                penguins.filter((d) => d.species === espece),
                                {
                                    x: "culmen_length_mm",
                                    y: "culmen_depth_mm",
                                    stroke: "species",
                                },
                            ),
                        ],
                    }}
                />
            </div>
        ))
    }

    <script>
        const select = document.querySelector("#species");
        const blocs = document.querySelectorAll("[data-species]");

        function afficher() {
            blocs.forEach((bloc) => {
                bloc.hidden = bloc.dataset.species !== select.value;
            });
        }

        select.addEventListener("change", afficher);
        afficher();
    </script>
</Layout>
